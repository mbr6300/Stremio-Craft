<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.stremio.craft.callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>stremiocraft</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>infuse</string>
		<string>vlc-x-callback</string>
		<string>vlc</string>
		<string>youtube</string>
		<string>vnd.youtube</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Meine Mediathek: das NAS kann unter beliebigem Namen (z. B. …synology.me) mit selbstsigniertem
		     Zertifikat oder per http erreichbar sein. Die Zertifikatsprüfung bleibt für alle anderen Server
		     aktiv; nur WebDAVClient akzeptiert ein selbstsigniertes Zertifikat, und nur für den NAS-Host.
		     Kein NSAllowsLocalNetworking dazu: dann ignoriert iOS NSAllowsArbitraryLoads. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
